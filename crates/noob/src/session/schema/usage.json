{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One request's cost, as computed prefill plus generation",
  "type": "object",
  "properties": {
    "t": { "const": "usage" },
    "prefilled": { "type": "integer", "minimum": 0 },
    "generated": { "type": "integer", "minimum": 0 }
  },
  "required": ["t", "prefilled", "generated"],
  "additionalProperties": false
}
